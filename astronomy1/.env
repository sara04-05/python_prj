# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://api.nasa.gov
NASA_API_KEY=your-nasa-api-key

# Key(s) that unlock the admin endpoints. Run `python generate_key.py` to create one.
# Several keys can be separated with commas.
API_KEYS='79f65eef-3551-402d-980d-69dfca6dc082'

# SQLite file, relative to this folder
DATABASE_URL=astronomy.db

# Where the Streamlit app finds the FastAPI backend
BASE_URL=http://127.0.0.1:8000/api
