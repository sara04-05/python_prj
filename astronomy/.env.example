# NASA APOD API Configuration
# Using the official NASA Science WordPress API (no API key needed!)
# Endpoint: https://science.nasa.gov/wp-json/wp/v2/apod-basic/
NASA_API_KEY=

# Your API key for Streamlit authentication
# Generate with: python auth/generate_key.py
API_KEY=your_secure_key_here

# FastAPI backend URL (for Streamlit frontend)
BASE_URL=http://localhost:8000/api
